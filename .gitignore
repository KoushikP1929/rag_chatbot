.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# The corpus snapshots travel with the repo so a serverless cold start can
# rebuild the Chroma index without scraping: raw provenance, one document per
# page, chunk rosters, and the embedding vectors. The vector store itself and
# the query traces stay machine-local.
data/chroma/*
data/traces/*
!data/chroma/.gitkeep
!data/traces/.gitkeep
