# Copy to .env and fill the key for the provider selected in config.yaml.
# GEMINI_API_KEY is also the question-embedding key (gemini-embedding-001,
# 768 dims; data/embeddings/* are committed in exactly that space).
# LLM_MODEL is a placeholder. Confirm the id against Groq's current model list before the demo.

GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b

# Optional overrides (serverless deployments use these):
# VECTORSTORE_PATH=/tmp/chroma
# TRACE_DIR=/tmp/traces
# EMBEDDING_QUERY_PROVIDER=gemini
# GEMINI_API_KEY=
# HF_API_TOKEN=
